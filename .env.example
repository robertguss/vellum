# Deployment Mode: solo (loopback only, zero OIDC/S3) | personal (single owner passphrase) | team (OIDC + S3/local)
# VELLUM_MODE=solo
# VELLUM_PERSONAL_PASSPHRASE=replace-with-strong-passphrase
# VELLUM_PERSONAL_PASSPHRASE_HASH=
# VELLUM_OWNER_EMAIL=owner@localhost
# VELLUM_OWNER_NAME=Workspace Owner
# VELLUM_ATTACHMENTS_BACKEND=local

# Required in team mode (32-byte / 64-hex-char AEAD application key; auto-generated in solo/personal mode)
# Generate with: openssl rand -hex 32
VELLUM_SECRET_KEY=1111111111111111111111111111111122222222222222222222222222222222

# Set to 1 ONLY for plain HTTP localhost development
VELLUM_INSECURE_COOKIES=1

# Session cookie & MoDB session lifetime in seconds (default 604800 = 7d; FERPA recommended 28800 = 8h)
VELLUM_SESSION_TTL_SECONDS=604800

# Vite HMR dev server (leave unset in production to serve public/manifest.json)
VELLUM_VITE_DEV_URL=http://127.0.0.1:5173

# OIDC / SSO (set VELLUM_OIDC_PROVIDER_ID=google to preset Google Workspace endpoints,
# or leave default dex settings matching docker-compose.dev.yml)
VELLUM_OIDC_PROVIDER_ID=dex
VELLUM_OIDC_CLIENT_ID=vellum-web
VELLUM_OIDC_CLIENT_SECRET=vellum-dev-oidc-secret
VELLUM_OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/oidc/callback
VELLUM_OIDC_ISSUER=http://127.0.0.1:5556/dex
VELLUM_OIDC_AUTH_URL=http://127.0.0.1:5556/dex/auth
VELLUM_OIDC_TOKEN_URL=http://127.0.0.1:5556/dex/token
VELLUM_OIDC_USERINFO_URL=http://127.0.0.1:5556/dex/userinfo
VELLUM_OIDC_JWKS_URI=
VELLUM_OIDC_GOOGLE_HD=
VELLUM_OIDC_ALLOWED_DOMAINS=acme.io
VELLUM_OIDC_REQUIRE_VERIFIED_EMAIL=1

# S3 / VersityGW / MinIO / Cloudflare R2 Object Storage & Encrypted Snapshots
VELLUM_S3_ENDPOINT=http://127.0.0.1:9000
VELLUM_S3_BUCKET=vellum-uploads
VELLUM_S3_REGION=us-east-1
VELLUM_S3_ACCESS_KEY_ID=vellum
VELLUM_S3_SECRET_ACCESS_KEY=vellum-dev-secret-key
VELLUM_S3_PATH_STYLE=1
# Optional dedicated 32-byte (64 hex char) AES-256-GCM key for S3 snapshot encryption
# (when unset, derived deterministically via SHA-256("vellum:backup:v1:" || VELLUM_SECRET_KEY))
VELLUM_BACKUP_KEY=
VELLUM_BACKUP_PREFIX=backups/vellum

# Built-in AI Provider (openai | anthropic); set VELLUM_AI_LOCAL_ONLY=1 when routing
# FERPA Restricted Vault allow_local_ai traffic through an internal campus AI proxy.
VELLUM_AI_PROVIDER=openai
VELLUM_AI_API_KEY=sk-replace-me
VELLUM_AI_BASE_URL=https://api.openai.com/v1/chat/completions
VELLUM_AI_MODEL=gpt-4o-mini
VELLUM_AI_LOCAL_ONLY=0
